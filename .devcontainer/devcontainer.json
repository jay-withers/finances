{
  "name": "finances",
  "image": "ghcr.io/jay-withers/dev-containers/terraform:v0.15.0@sha256:6f6a33710e2181787e693134cf34aa87d0a93a8ef0289b9ca47d15190c11c55a",
  "mounts": [
    "source=${localEnv:HOME}/Git,target=/Users/jay/Git,type=bind",
    // hadolint runs as a container, so the pre-commit hook needs the daemon.
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  // What `make run` binds. Without this the server starts and the browser has
  // nothing to connect to.
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "finances",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "hashicorp.terraform",
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  },
  "remoteUser": "vscode",
  // Installs the pre-commit hooks and syncs the Python environment. Re-run it
  // by hand after a rebuild if uv is missing: it installs into ~/.local/bin,
  // which is the container's writable layer and does not survive one.
  "postCreateCommand": "make install",
  "postStartCommand": "sudo /usr/local/bin/docker-socket-setup"
}
