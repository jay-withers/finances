{
  "name": "finances",
  "image": "ghcr.io/jay-withers/dev-containers/terraform:v0.17.2@sha256:17deffe2406145b67b1f5d4d75730bbfcb658e5abd38e2e0daa091e8dc281ca7",
  "mounts": [
    // The same source works on every host: Docker Desktop (macOS, Windows)
    // resolves it inside its own VM. docker-socket-setup handles the ownership
    // difference (a docker group on Linux, a root-owned socket on Desktop).
    // hadolint runs as a container, so the pre-commit hook needs the daemon.
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  // What `make run` binds. Without this the server starts and the browser has
  // nothing to connect to.
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "finances",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "hashicorp.terraform",
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  },
  "remoteUser": "vscode",
  // Installs the pre-commit hooks and syncs the Python environment. Re-run it
  // by hand after a rebuild if uv is missing: it installs into ~/.local/bin,
  // which is the container's writable layer and does not survive one.
  "postCreateCommand": "make install",
  "postStartCommand": "sudo /usr/local/bin/docker-socket-setup"
}
